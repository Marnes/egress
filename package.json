{
  "name": "egress",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "workspaces": [
    "core",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c blue,green \"npm run dev -w web\" \"npm run dev -w server\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "vitest run",
    "typecheck": "tsc -p core/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && npm run check -w web",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.0.15"
  }
}
